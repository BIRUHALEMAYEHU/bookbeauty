# ─── How to fill this file ───────────────────────────────────────────────────
# 1) Create a NEW Supabase project (separate from TeamFlow).
# 2) Supabase → Project Settings → Database → Connection string:
#    - URI (Transaction pooler, port 6543) → DATABASE_URL  (add ?pgbouncer=true)
#    - URI (Session / Direct, port 5432)   → DIRECT_URL
# 3) Generate long random JWT secrets (different from each other).
# 4) Resend → API Keys → RESEND_API_KEY; verify a sending domain → EMAIL_FROM
# 5) Copy this file to `.env`, fill values, then:
#      npm install
#      npx prisma migrate deploy
#      npm run prisma:generate
#      npm run dev:api
#
# Never commit the real `.env`.

# Postgres (Supabase)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

JWT_SECRET=change-me-product-jwt-secret-long-random
PLATFORM_JWT_SECRET=change-me-platform-jwt-secret-different-random

FRONTEND_URL=http://127.0.0.1:3000
PUBLIC_SITE_URL=http://127.0.0.1:3020
PLATFORM_ADMIN_URL=http://127.0.0.1:3010
CORS_ORIGINS=

NODE_ENV=development
PORT=3001

# Resend (OTP + booking emails). Leave empty in dev → OTP prints in API console.
RESEND_API_KEY=
EMAIL_FROM="Book <noreply@your-verified-domain.com>"

# Platform owner seed (min password 12 chars)
# PLATFORM_OWNER_EMAIL=ops@example.com
# PLATFORM_OWNER_PASSWORD=use-a-long-random-password
# PLATFORM_OWNER_NAME=Platform Owner
