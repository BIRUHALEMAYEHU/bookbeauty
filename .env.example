# Local development database (started with `docker compose up -d`)
DATABASE_URL=postgres://book:book@localhost:5432/book

# Used by `npm test`; created automatically by the Docker container
TEST_DATABASE_URL=postgres://book:book@localhost:5432/book_test

# At least 32 random characters. Used to sign OAuth state cookies.
SESSION_SECRET=change-me-to-a-long-random-string-please

# Public URL of this app (no trailing slash)
APP_URL=http://localhost:3000

# Optional: Google OAuth (leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Telegram Login Widget (leave blank to hide the Telegram button)
# Create a bot with @BotFather, then /setdomain to your APP_URL host.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
